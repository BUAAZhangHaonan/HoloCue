# Copy to .env and export deliberately. Credentials must stay outside version control.
HOLOCUE_MODE=live
HOLOCUE_MODEL_URL=http://127.0.0.1:8000/v1
HOLOCUE_MODEL_NAME=Qwen/Qwen3.5-4B
HOLOCUE_MODEL_API_KEY=
HOLOCUE_API_KEY=
MODEL_SIZE=4B
ENGINE=vllm
GPUS=1
GPU_FRACTION=0.70
# BLENDER_BIN=/path/to/existing/blender
# SOURCE_SSH=your-existing-authorized-4028-alias
# SOURCE_MODEL_PATH=/home/g203-4028/Models/Qwen3.5-4B

# Scene bundle for API, Viser, builds and capture; defaults to reconstructed.
HOLOCUE_SCENE_SET=reconstructed
# Each send includes a real Viser camera PNG. text_state selects the historical text-only protocol.
HOLOCUE_OBSERVATION_MODE=camera_rgb
# RUN_DIR overrides runs/simulation/<scene-set> for one isolated run.
